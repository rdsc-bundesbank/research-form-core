{
  "name": "@rdsc/research-form-core",
  "version": "1.0.6",
  "description": "Reusable, institution-agnostic form engine for research data applications: field renderer, validation UI, dataset table, identifier linkage graph and shared types.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdsc-bundesbank/research-form-core"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style/custom-theme.css"
  },
  "files": [
    "dist",
    "style"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.13.0",
    "d3": "^7.9.0",
    "jszip": "^3.10.0",
    "rc-slider": "^11.1.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-select": "^5.10.0",
    "react-table": "^7.8.0",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.3.4"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-table": "^7.7.20",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11",
    "zod": "^3.23.8"
  }
}
